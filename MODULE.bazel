module(
    name = "dnf5-prebuilt",
    version = "0.0.0",
    bazel_compatibility = [">=7.1.0"],
)

# Core Bazel & platform dependencies from BCR (latest published versions)
bazel_dep(name = "platforms", version = "1.1.0")

bazel_dep(name = "platforms_contrib", version = "1.0.0-alpha.0", dev_dependency = True)
bazel_dep(name = "bazel_skylib", version = "1.9.2", dev_dependency = True)
bazel_dep(name = "bazel_lib", version = "3.7.2", dev_dependency = True)
bazel_dep(name = "rules_cc", version = "0.2.26", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)
bazel_dep(name = "tar.bzl", version = "0.10.9", dev_dependency = True)

# Hermetic LLVM C/C++ toolchain from BCR
bazel_dep(name = "llvm", version = "0.8.26", dev_dependency = True)
single_version_override(
    module_name = "llvm",
    patch_strip = 1,
    patches = ["//bazel:patches/llvm-exclude-fontparser.patch"],
)

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)

# The hermetic macOS SDK only ships a minimal set of frameworks by default;
# glib/gio (librepo) additionally need CoreServices and AppKit.
osx = use_extension("@llvm//extensions:osx.bzl", "osx", dev_dependency = True)
osx.frameworks(names = [
    # llvm defaults
    "CoreFoundation",
    "Foundation",
    "Kernel",
    "OSLog",
    "Security",
    "SystemConfiguration",
    # glib/gio and the frameworks their headers pull in
    "AppKit",
    "ApplicationServices",
    "CFNetwork",
    "Carbon",
    "Cocoa",
    "ColorSync",
    "CoreData",
    "CoreGraphics",
    "CoreImage",
    "CoreServices",
    "CoreText",
    "CoreVideo",
    "DiskArbitration",
    "IOKit",
    "IOSurface",
    "ImageIO",
    "Metal",
    "OpenGL",
    "PrintCore",
    "QuartzCore",
    "Symbols",
    "UniformTypeIdentifiers",
])

# Hermetic Rust toolchain (rpm-sequoia) via rules_rs, linking with the LLVM
# toolchain above.
bazel_dep(name = "rules_rs", version = "0.1.3", dev_dependency = True)

rust_toolchains = use_extension(
    "@rules_rs//rs/toolchains:module_extension.bzl",
    "toolchains",
    dev_dependency = True,
)
rust_toolchains.toolchain(
    edition = "2021",
    version = "1.92.0",
)
use_repo(rust_toolchains, "default_rust_toolchains")

register_toolchains(
    "@default_rust_toolchains//...",
    dev_dependency = True,
)

# Remote Execution Platform setup from BCR
bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4", dev_dependency = True)

buildbuddy = use_extension(
    "@toolchains_buildbuddy//:extensions.bzl",
    "buildbuddy",
    dev_dependency = True,
)
buildbuddy.platform(
    container_image = "docker://gcr.io/flame-public/rbe-ubuntu24-04@sha256:be9853fc45092d2cf2bda3abed30d22182881659a50bf35c7125161d7cfc8a75",
)
use_repo(buildbuddy, "buildbuddy_toolchain")

# The image above, unless RBE_CONTAINER_IMAGE is set with --repo_env.
rbe_container_image = use_repo_rule("//bazel:rbe.bzl", "rbe_container_image")

rbe_container_image(
    name = "rbe_container_image",
    dev_dependency = True,
)

# Dependencies used to build dnf5 from source. Modules not available in the
# BCR live in the local registry under bazel/3rdparty. All of them are dev-only:
# consumers of the dnf5-prebuilt ruleset download prebuilt binaries instead.
bazel_dep(name = "toml11", version = "4.4.0", dev_dependency = True)
bazel_dep(name = "curl", version = "8.22.0.bcr.1", dev_dependency = True)
bazel_dep(name = "fmt", version = "12.2.0.bcr.1", dev_dependency = True)
bazel_dep(name = "glib", version = "2.84.4", dev_dependency = True)
bazel_dep(name = "libxml2", version = "2.15.3", dev_dependency = True)
bazel_dep(name = "openssl", version = "4.0.1.bcr.2", dev_dependency = True)
bazel_dep(name = "sqlite3", version = "3.53.4", dev_dependency = True)
bazel_dep(name = "zlib", version = "1.3.2.bcr.3", dev_dependency = True)
bazel_dep(name = "json-c", version = "0.19", dev_dependency = True)
bazel_dep(name = "libacl", version = "2.4.0", dev_dependency = True)
bazel_dep(name = "libmodulemd", version = "2.15.3.dnf5.1", dev_dependency = True)
bazel_dep(name = "libpkgmanifest", version = "0.6.1", dev_dependency = True)
bazel_dep(name = "libsolv", version = "0.7.41", dev_dependency = True)
bazel_dep(name = "librepo", version = "1.21.2", dev_dependency = True)
bazel_dep(name = "libsmartcols", version = "2.42.4", dev_dependency = True)
bazel_dep(name = "popt", version = "1.19.dnf5.1", dev_dependency = True)
bazel_dep(name = "rpm", version = "6.1.0", dev_dependency = True)
bazel_dep(name = "rpm-sequoia", version = "1.10.3", dev_dependency = True)

# Upstream dnf5 sources with the Bazel overlay from //bazel/dnf5.
dnf5_extension = use_extension(
    "//bazel:extensions.bzl",
    "dnf5_extension",
    dev_dependency = True,
)
use_repo(dnf5_extension, "dnf5")
