load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")

exports_files(["LICENSE"])

filegroup(
    name = "local_repository_files",
    srcs = [
        "BUILD.bazel",
        "LICENSE",
        "MODULE.bazel",
        "REPO.bazel",
        "//dnf5-prebuilt:all_files",
        "//dnf5-prebuilt/private:all_files",
    ],
    visibility = ["//visibility:public"],
)

buildifier(
    name = "buildifier",
    exclude_patterns = [
        "./.git/*",
        "./.worktrees/*",
        "./bazel/3rdparty/modules/*",
    ],
    lint_mode = "fix",
    mode = "fix",
)

buildifier_test(
    name = "buildifier_test",
    exclude_patterns = [
        "./.git/*",
        "./.worktrees/*",
        "./bazel/3rdparty/modules/*",
    ],
    lint_mode = "warn",
    mode = "diff",
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)
