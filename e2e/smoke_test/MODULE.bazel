"""Uses the public API of dnf5-prebuilt like a consumer would."""

module(name = "smoke_test")

bazel_dep(name = "dnf5-prebuilt", version = "0.0.0")
local_path_override(
    module_name = "dnf5-prebuilt",
    path = "../..",
)

bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "rules_shell", version = "0.8.0")

# Hermetic Python for the test repository generator (testdata/generate_repodata.py)
bazel_dep(name = "aspect_rules_py", version = "2.0.0-alpha.8")

interpreters = use_extension("@aspect_rules_py//py:extensions.bzl", "python_interpreters")
interpreters.toolchain(python_version = "3.14")
use_repo(
    interpreters,
    "python_3_14_aarch64_apple_darwin",
    "python_3_14_aarch64_unknown_linux_gnu",
    "python_3_14_x86_64_apple_darwin",
    "python_3_14_x86_64_unknown_linux_gnu",
    "python_interpreters",
)

register_toolchains("@python_interpreters//:all")

dnf5 = use_extension("@dnf5-prebuilt//dnf5-prebuilt:extensions.bzl", "dnf5")
dnf5.toolchains()
use_repo(dnf5, "dnf5_toolchains")

register_toolchains("@dnf5_toolchains//:all")
