load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")

package(default_visibility = ["//visibility:public"])

exports_files([
    "changed_integrity.lock.json",
    "features.repo",
    "generate_repodata.py",
    "ol9_repo/curl-7.76.1-40.el9_8.8.x86_64.rpm",
    "ol9_repo/libcurl-7.76.1-40.el9_8.8.x86_64.rpm",
    "ol9_repo/ol9.repo",
    "test.repo",
])

py_binary(
    name = "generate_repodata",
    srcs = ["generate_repodata.py"],
    main = "generate_repodata.py",
)

run_binary(
    name = "generate_test_repodata",
    outs = [
        "repo/repodata/filelists.xml.gz",
        "repo/repodata/other.xml.gz",
        "repo/repodata/prestodelta.xml.gz",
        "repo/repodata/primary.xml.gz",
        "repo/repodata/repomd.xml",
        "repo/repodata/updateinfo.xml.gz",
    ],
    args = [
        "--out-dir",
        "$(RULEDIR)/repo/repodata",
    ],
    tool = ":generate_repodata",
)

filegroup(
    name = "test_repo_files",
    srcs = [
        "repo/disagree/mystery-devel-19.67-1.noarch.rpm",
        "repo/disagree/tour-4-6.noarch.rpm",
        "repo/drpms/tour-4-5_4-6.noarch.drpm",
        "repo/mystery-devel-19.67-1.noarch.rpm",
        "repo/tour-4-6.noarch.rpm",
        ":generate_test_repodata",
    ],
)

# Synthetic metadata-only repository for the dnf5 lock option tests
run_binary(
    name = "generate_features_repodata",
    outs = [
        "features-repo/repodata/filelists.xml.gz",
        "features-repo/repodata/modules.yaml.gz",
        "features-repo/repodata/other.xml.gz",
        "features-repo/repodata/primary.xml.gz",
        "features-repo/repodata/repomd.xml",
    ],
    args = [
        "--scenario",
        "features",
        "--out-dir",
        "$(RULEDIR)/features-repo/repodata",
    ],
    tool = ":generate_repodata",
)

filegroup(
    name = "features_repo_files",
    srcs = [":generate_features_repodata"],
)

filegroup(
    name = "ol9_repo_files",
    srcs = glob(["ol9_repo/**"]),
)

# Golden lockfiles of the rpm_lock cases in //:BUILD.bazel (normalized, see //:normalize_lock). The generated tests diff the
# lockfiles against them; to accept a change run `bazel run //testdata:lock_golden`.
write_source_files(
    name = "lock_golden",
    files = {
        "lock_golden/%s.json" % case: "//:%s_norm.json" % case
        for case in [
            "test_generated_lock",
            "layer2_already_installed_lock",
            "layer2_incremental_lock",
            "layer2_both_lock",
            "changed_integrity_lock",
            "attrs_excludepkgs_lock",
            "attrs_nobest_lock",
            "attrs_noweak_lock",
            "attrs_module_lock",
            "attrs_forcearch_lock",
        ]
    },
    tags = ["lock_golden"],
)
