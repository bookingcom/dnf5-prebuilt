load("@rules_shell//shell:sh_test.bzl", "sh_test")

sh_test(
    name = "smoke_test",
    srcs = ["smoke_test.sh"],
    data = ["@dnf5-prebuilt//dnf5-prebuilt:current_toolchain"],
    env = {"DNF5": "$(rootpath @dnf5-prebuilt//dnf5-prebuilt:current_toolchain)"},
)

sh_test(
    name = "alias_smoke_test",
    srcs = ["smoke_test.sh"],
    data = ["@dnf5-prebuilt//dnf5-prebuilt:dnf5"],
    env = {"DNF5": "$(rootpath @dnf5-prebuilt//dnf5-prebuilt:dnf5)"},
)

sh_test(
    name = "rpm_smoke_test",
    srcs = ["rpm_smoke_test.sh"],
    data = ["@dnf5-prebuilt//dnf5-prebuilt:rpm"],
    env = {"RPM": "$(rootpath @dnf5-prebuilt//dnf5-prebuilt:rpm)"},
)

# The README example: $(DNF5) in a genrule.
genrule(
    name = "dnf5_version",
    outs = ["dnf5_version.txt"],
    cmd = "$(DNF5) --version > $@",
    toolchains = ["@dnf5-prebuilt//dnf5-prebuilt:current_toolchain"],
    tools = ["@dnf5-prebuilt//dnf5-prebuilt:current_toolchain"],
)

sh_test(
    name = "genrule_test",
    srcs = ["genrule_test.sh"],
    data = [":dnf5_version"],
    env = {"VERSION_FILE": "$(rootpath :dnf5_version)"},
)
