load("@dnf5-prebuilt//dnf5-prebuilt:defs.bzl", "dnf_config", "rpm_mark")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":lock_golden.bzl", "lock_golden")

# //testdata:lock_golden diffs the normalized lockfiles of this package.
package(default_visibility = ["//testdata:__pkg__"])

# The dnf5 launcher of the registered toolchain, with the distribution as runfiles.
DNF5 = "@dnf5-prebuilt//dnf5-prebuilt:current_toolchain"

DNF5_ROOTPATH = "$(rootpath %s)" % DNF5

sh_test(
    name = "smoke_test",
    srcs = ["smoke_test.sh"],
    data = [DNF5],
    env = {"DNF5": DNF5_ROOTPATH},
)

# The README example: $(DNF5) in a genrule.
genrule(
    name = "dnf5_version",
    outs = ["dnf5_version.txt"],
    cmd = "$(DNF5) --version > $@",
    toolchains = [DNF5],
    tools = [DNF5],
)

sh_test(
    name = "genrule_test",
    srcs = ["genrule_test.sh"],
    data = [":dnf5_version"],
    env = {"VERSION_FILE": "$(rootpath :dnf5_version)"},
)

# --- The rules: dnf_config, rpm_lock and rpm_mark ----------------------------

# dnf5 smoke: repo load, repoquery and a solver run against the Oracle Linux 9 test repository
sh_test(
    name = "dnf5_smoke_test",
    srcs = ["test_dnf5.sh"],
    args = [
        DNF5_ROOTPATH,
        "testdata/ol9_repo",
        "testdata/repo/tour-4-6.noarch.rpm",
    ],
    data = [
        ":dnf5_test_lib",
        DNF5,
        "//testdata:ol9_repo_files",
        "//testdata:test_repo_files",
    ],
)

# dnf_config renders dnf.conf and the .repo file; the preamble makes dnf5 read only those.
dnf_config(
    name = "ol9_dnf_config",
    excludepkgs = ["mystery-devel"],
    install_weak_deps = False,
    module_platform_id = "platform:el9",
    releasever = "9",
    repo_configs = ["//testdata:ol9_repo/ol9.repo"],
    repo_files = ["//testdata:ol9_repo_files"],
)

filegroup(
    name = "dnf5_test_lib",
    srcs = ["dnf5_lib.sh"],
)

sh_test(
    name = "dnf5_config_smoke_test",
    srcs = ["test_dnf5_config.sh"],
    args = [
        DNF5_ROOTPATH,
        "$(rootpath :ol9_dnf_config)",
        "testdata/ol9_repo",
    ],
    data = [
        ":dnf5_test_lib",
        ":ol9_dnf_config",
        DNF5,
    ],
)

# dnf5's effective configuration under the preamble holds no host path and equals the golden file.
# To update it, copy dnf5_config_golden.txt from the test's undeclared outputs (bazel-testlogs/.../test.outputs).
sh_test(
    name = "dnf5_config_golden_test",
    srcs = ["test_dnf5_config_golden.sh"],
    args = [
        DNF5_ROOTPATH,
        "$(rootpath :ol9_dnf_config)",
        "testdata/ol9_repo",
        "$(rootpath dnf5_config_golden.txt)",
    ],
    data = [
        "dnf5_config_golden.txt",
        ":dnf5_test_lib",
        ":ol9_dnf_config",
        DNF5,
    ],
)

# Replaces the sandbox paths of a lockfile (see lock_golden.bzl and normalize_lock.sh).
sh_binary(
    name = "normalize_lock",
    srcs = ["normalize_lock.sh"],
)

# Step 2 test: Lockfile generation with RPM exclusion
lock_golden(
    name = "test_generated_lock",
    out = "test_generated_lock.lock.json",
    exclude = ["mystery-devel"],
    packages = ["tour"],
    repo_config = "//testdata:test.repo",
    repo_files = ["//testdata:test_repo_files"],
)

sh_test(
    name = "rpm_lock_test",
    srcs = ["test_lock.sh"],
    args = [
        "$(rootpath :test_generated_lock.lock.json)",
    ],
    data = [
        ":test_generated_lock.lock.json",
    ],
)

sh_test(
    name = "lock_run_test",
    srcs = ["test_lock_run.sh"],
    args = [
        "test_generated_lock_run.sh",
        "$(rootpath :test_generated_lock.lock.json)",
        "test_generated_lock.lock.json",
    ],
    data = [
        ":test_generated_lock",
        ":test_generated_lock.lock.json",
    ],
)

# Incremental lockfile tests
lock_golden(
    name = "layer2_already_installed_lock",
    out = "layer2_already_installed.lock.json",
    lock_files = [":test_generated_lock.lock.json"],
    packages = ["tour"],
    repo_config = "//testdata:test.repo",
    repo_files = ["//testdata:test_repo_files"],
)

lock_golden(
    name = "layer2_incremental_lock",
    out = "layer2_incremental.lock.json",
    lock_files = [":test_generated_lock.lock.json"],
    packages = ["mystery-devel"],
    repo_config = "//testdata:test.repo",
    repo_files = ["//testdata:test_repo_files"],
)

lock_golden(
    name = "layer2_both_lock",
    out = "layer2_both.lock.json",
    lock_files = [":test_generated_lock.lock.json"],
    packages = [
        "mystery-devel",
        "tour",
    ],
    repo_config = "//testdata:test.repo",
    repo_files = ["//testdata:test_repo_files"],
)

lock_golden(
    name = "changed_integrity_lock",
    out = "changed_integrity.lock.json",
    lock_files = ["//testdata:changed_integrity.lock.json"],
    packages = ["tour"],
    repo_config = "//testdata:test.repo",
    repo_files = ["//testdata:test_repo_files"],
)

sh_test(
    name = "incremental_lock_test",
    srcs = ["test_incremental_lock.sh"],
    args = [
        "$(rootpath :layer2_already_installed.lock.json)",
        "$(rootpath :layer2_incremental.lock.json)",
        "$(rootpath :layer2_both.lock.json)",
        "$(rootpath :changed_integrity.lock.json)",
    ],
    data = [
        ":changed_integrity.lock.json",
        ":layer2_already_installed.lock.json",
        ":layer2_both.lock.json",
        ":layer2_incremental.lock.json",
    ],
)

dnf_config(
    name = "features_dnf_config",
    module_platform_id = "platform:el9",
    releasever = "9",
    repo_configs = ["//testdata:features.repo"],
    repo_files = ["//testdata:features_repo_files"],
)

# `dnf5 lock` options: excludepkgs, module enable, best/nobest, forcearch, duplicate repos, weak deps.
sh_test(
    name = "lock_features_test",
    srcs = ["test_lock_features.sh"],
    args = [
        DNF5_ROOTPATH,
        "$(rootpath //testdata:features-repo/repodata/repomd.xml)",
        "$(rootpath :features_dnf_config)",
    ],
    data = [
        ":dnf5_test_lib",
        ":features_dnf_config",
        DNF5,
        "//testdata:features-repo/repodata/repomd.xml",
        "//testdata:features_repo_files",
    ],
    shard_count = 6,
)

# The same options through the rpm_lock attributes (golden lockfiles in //testdata)
lock_golden(
    name = "attrs_excludepkgs_lock",
    out = "attrs_excludepkgs.lock.json",
    excludepkgs = ["ca-certificates-2026.2.92_v9.0.319-*"],
    packages = ["certuser"],
    repo_config = "//testdata:features.repo",
    repo_files = ["//testdata:features_repo_files"],
)

lock_golden(
    name = "attrs_nobest_lock",
    out = "attrs_nobest.lock.json",
    nobest = True,
    packages = ["bestapp"],
    repo_config = "//testdata:features.repo",
    repo_files = ["//testdata:features_repo_files"],
)

lock_golden(
    name = "attrs_noweak_lock",
    out = "attrs_noweak.lock.json",
    install_weak_deps = False,
    packages = ["weakapp"],
    repo_config = "//testdata:features.repo",
    repo_files = ["//testdata:features_repo_files"],
)

lock_golden(
    name = "attrs_module_lock",
    out = "attrs_module.lock.json",
    module_enable = ["mysql:8.4"],
    module_platform_id = "platform:el9",
    packages = ["mysql"],
    repo_config = "//testdata:features.repo",
    repo_files = ["//testdata:features_repo_files"],
)

lock_golden(
    name = "attrs_forcearch_lock",
    out = "attrs_forcearch.lock.json",
    forcearch = "x86_64",
    packages = ["expat"],
    repo_config = "//testdata:features.repo",
    repo_files = ["//testdata:features_repo_files"],
)

sh_test(
    name = "lock_attrs_test",
    srcs = ["test_lock_attrs.sh"],
    args = [
        "$(rootpath :attrs_excludepkgs.lock.json)",
        "$(rootpath :attrs_nobest.lock.json)",
        "$(rootpath :attrs_module.lock.json)",
        "$(rootpath :attrs_forcearch.lock.json)",
        "$(rootpath :attrs_noweak.lock.json)",
    ],
    data = [
        ":attrs_excludepkgs.lock.json",
        ":attrs_forcearch.lock.json",
        ":attrs_module.lock.json",
        ":attrs_nobest.lock.json",
        ":attrs_noweak.lock.json",
    ],
)

dnf_config(
    name = "test_dnf_config",
    releasever = "9",
    repo_configs = ["//testdata:test.repo"],
    repo_files = ["//testdata:test_repo_files"],
)

# `dnf5 lock` run directly, under the preamble of a dnf_config.
sh_test(
    name = "lock_direct_test",
    srcs = ["test_lock_direct.sh"],
    args = [
        DNF5_ROOTPATH,
        "$(rootpath //testdata:test.repo)",
        "$(rootpath //testdata:repo/repodata/repomd.xml)",
        "$(rootpath :test_generated_lock.lock.json)",
        "$(rootpath :test_dnf_config)",
    ],
    data = [
        ":dnf5_test_lib",
        ":test_dnf_config",
        ":test_generated_lock.lock.json",
        DNF5,
        "//testdata:repo/repodata/repomd.xml",
        "//testdata:test.repo",
        "//testdata:test_repo_files",
    ],
)

# `dnf5 lock --lockfile` on small metadata-only repositories.
sh_test(
    name = "lock_layers_test",
    srcs = ["test_lock_layers.sh"],
    args = [
        "$(rootpath :test_lock_layers.py)",
        DNF5_ROOTPATH,
        "$(rootpath :ol9_dnf_config)",
    ],
    data = [
        ":ol9_dnf_config",
        ":test_lock_layers.py",
        DNF5,
    ],
)

rpm_mark(
    name = "ol9_marked_rpmdb",
    arch = "x86_64",
    packages = [
        "curl=7.76.1-40.el9_8.8",
    ],
    releasever = "9",
    repo_config = "//testdata:ol9_repo/ol9.repo",
    repo_files = ["//testdata:ol9_repo_files"],
)

# rpm_mark and the standalone `dnf5 rpmdb-mark`: the rpmdb holds exactly curl and libcurl.
sh_test(
    name = "rpm_mark_test",
    srcs = ["test_rpm_mark.sh"],
    args = [
        "$(rootpath :ol9_marked_rpmdb)",
        DNF5_ROOTPATH,
        "$(rootpath :ol9_dnf_config)",
        "testdata/ol9_repo",
    ],
    data = [
        ":dnf5_test_lib",
        ":ol9_dnf_config",
        ":ol9_marked_rpmdb",
        DNF5,
        "//testdata:ol9_repo_files",
    ],
)
