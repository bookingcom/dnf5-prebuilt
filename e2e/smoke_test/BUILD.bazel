load("@aspect_rules_py//py:defs.bzl", "py_test")
load("@dnf5-prebuilt//dnf5-prebuilt:defs.bzl", "dnf_config", "rpm_lock", "rpm_mark")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

DNF5 = "@dnf5-prebuilt//dnf5-prebuilt:current_toolchain"

DNF5_ROOTPATH = "$(rootpath %s)" % DNF5

sh_test(
    name = "smoke_test",
    srcs = ["smoke_test.sh"],
    data = [DNF5],
    env = {"DNF5": DNF5_ROOTPATH},
)

sh_test(
    name = "alias_smoke_test",
    srcs = ["smoke_test.sh"],
    data = ["@dnf5-prebuilt//dnf5-prebuilt:dnf5"],
    env = {"DNF5": "$(rootpath @dnf5-prebuilt//dnf5-prebuilt:dnf5)"},
)

sh_test(
    name = "rpm_smoke_test",
    srcs = ["rpm_smoke_test.sh"],
    data = [
        ":ol9_base_rpmdb",
        ":ol9_layered_rpmdb",
        ":ol9_marked_rpmdb",
        "@dnf5-prebuilt//dnf5-prebuilt:rpm",
    ],
    env = {
        "RPM": "$(rootpath @dnf5-prebuilt//dnf5-prebuilt:rpm)",
        "RPMDB_BASE": "$(rootpath :ol9_base_rpmdb)",
        "RPMDB_LAYERED": "$(rootpath :ol9_layered_rpmdb)",
        "RPMDB_SINGLE": "$(rootpath :ol9_marked_rpmdb)",
    },
)

# The README example: $(DNF5) in a genrule.
genrule(
    name = "dnf5_version",
    outs = ["dnf5_version.txt"],
    cmd = "$(DNF5) --version > $@",
    toolchains = [DNF5],
    tools = [DNF5],
)

sh_test(
    name = "genrule_test",
    srcs = ["genrule_test.sh"],
    data = [":dnf5_version"],
    env = {"VERSION_FILE": "$(rootpath :dnf5_version)"},
)

# --- The rules: dnf_config --------------------------------------------------

# dnf_config renders dnf.conf and the .repo file; the preamble makes dnf5 read only those.
dnf_config(
    name = "ol9_dnf_config",
    excludepkgs = ["mystery-devel"],
    install_weak_deps = False,
    module_platform_id = "platform:el9",
    releasever = "9",
    repo_configs = ["//testdata:ol9_repo/ol9.repo"],
    repo_files = ["//testdata:ol9_repo_files"],
)

filegroup(
    name = "dnf5_test_lib",
    srcs = ["dnf5_lib.sh"],
)

sh_test(
    name = "dnf5_config_smoke_test",
    srcs = ["test_dnf5_config.sh"],
    args = [
        DNF5_ROOTPATH,
        "$(rootpath :ol9_dnf_config)",
        "testdata/ol9_repo",
    ],
    data = [
        ":dnf5_test_lib",
        ":ol9_dnf_config",
        DNF5,
    ],
)

# dnf5's effective configuration under the preamble holds no host path and equals the golden file.
sh_test(
    name = "dnf5_config_golden_test",
    srcs = ["test_dnf5_config_golden.sh"],
    args = [
        DNF5_ROOTPATH,
        "$(rootpath :ol9_dnf_config)",
        "testdata/ol9_repo",
        "$(rootpath dnf5_config_golden.txt)",
    ],
    data = [
        "dnf5_config_golden.txt",
        ":dnf5_test_lib",
        ":ol9_dnf_config",
        DNF5,
    ],
)

# --- rpm_mark ---------------------------------------------------------------

rpm_mark(
    name = "ol9_marked_rpmdb",
    rpms = [
        "//testdata:ol9_repo/curl-7.76.1-40.el9_8.8.x86_64.rpm",
        "//testdata:ol9_repo/libcurl-7.76.1-40.el9_8.8.x86_64.rpm",
    ],
)

rpm_mark(
    name = "ol9_base_rpmdb",
    rpms = [
        "//testdata:ol9_repo/libcurl-7.76.1-40.el9_8.8.x86_64.rpm",
    ],
)

rpm_mark(
    name = "ol9_layered_rpmdb",
    base_rpmdb = ":ol9_base_rpmdb",
    rpms = [
        "//testdata:ol9_repo/curl-7.76.1-40.el9_8.8.x86_64.rpm",
    ],
)

rpm_mark(
    name = "mystery_base_rpmdb",
    rpms = [
        "//testdata:repo/mystery-devel-19.67-1.noarch.rpm",
    ],
)

# --- rpm_lock ---------------------------------------------------------------

# Single-layer solve: resolves tour and its required dependency mystery-devel
rpm_lock(
    name = "test_tour_lock",
    out = "test_tour_lock.lock.json",
    arch = [
        "x86_64",
        "noarch",
    ],
    packages = ["tour"],
    releasever = "9",
    repo_configs = ["//testdata:test.repo"],
    repo_files = ["//testdata:test_repo_files"],
)

# Multi-layer solve: resolves tour on top of mystery_base_rpmdb (which already contains mystery-devel)
rpm_lock(
    name = "test_layered_lock",
    out = "test_layered_lock.lock.json",
    arch = [
        "x86_64",
        "noarch",
    ],
    base_rpmdb = ":mystery_base_rpmdb",
    packages = ["tour"],
    releasever = "9",
    repo_configs = ["//testdata:test.repo"],
    repo_files = ["//testdata:test_repo_files"],
)

py_test(
    name = "rpm_lock_test",
    srcs = ["test_lock.py"],
    args = [
        "$(rootpath :test_tour_lock.lock.json)",
        "$(rootpath :test_layered_lock.lock.json)",
    ],
    data = [
        ":test_layered_lock.lock.json",
        ":test_tour_lock.lock.json",
    ],
)

sh_test(
    name = "lock_run_test",
    srcs = ["test_lock_run.sh"],
    args = [
        "test_tour_lock_run.sh",
        "$(rootpath :test_tour_lock.lock.json)",
        "test_tour_lock.lock.json",
    ],
    data = [
        ":test_tour_lock",
        ":test_tour_lock.lock.json",
    ],
)
