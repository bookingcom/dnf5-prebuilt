load("@dnf5-prebuilt//dnf5-prebuilt:defs.bzl", "rpm_layer", "rpm_lock", "rpm_mark")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(
    ":image_rpm.bzl",
    "centos_stream_9_environment",
    "oraclelinux_10_environment",
    "oraclelinux_9_environment",
)

# Pinned OL9 curl builds (MODULE.bazel), in install order: libcurl before curl.
OL9_CURL_RPMS = [
    "@ol9_libcurl_rpm//file",
    "@ol9_curl_rpm//file",
]

OL9_CURL_AARCH64_RPMS = [
    "@ol9_libcurl_aarch64_rpm//file",
    "@ol9_curl_aarch64_rpm//file",
]

# Extract rpmdb and repository configurations from container images.
oraclelinux_9_environment(name = "ol9")

oraclelinux_10_environment(name = "ol10")

centos_stream_9_environment(name = "centos9")

# Generate lock files resolving packages on top of the image rpmdb.
rpm_lock(
    name = "ol9_curl_lock",
    base_rpmdb = ":ol9_rpmdb",
    config = ":ol9_dnf_config",
    packages = ["curl"],
    # Reused for scriptlet inspection when they match the resolved builds; others are downloaded.
    rpms = OL9_CURL_RPMS,
)

rpm_lock(
    name = "ol10_lock",
    base_rpmdb = ":ol10_rpmdb",
    config = ":ol10_dnf_config",
    packages = ["curl"],
)

rpm_lock(
    name = "centos9_lock",
    base_rpmdb = ":centos9_rpmdb",
    config = ":centos9_dnf_config",
    packages = ["jq"],
)

# Test that generated lock files contain valid package entries, URLs, and sha256 checksums.
sh_test(
    name = "test_generated_locks",
    srcs = ["run_lock_test.sh"],
    args = [
        "$(rootpath :ol9_curl_lock)",
        "$(rootpath :ol10_lock)",
        "$(rootpath :centos9_lock)",
    ],
    data = [
        "test_lock_generated.py",
        ":centos9_lock",
        ":ol10_lock",
        ":ol9_curl_lock",
    ],
)

# Mark curl and libcurl RPMs as installed on top of the OL9 base rpmdb.
rpm_mark(
    name = "ol9_curl_rpmdb",
    base_rpmdb = ":ol9_rpmdb",
    rpms = OL9_CURL_RPMS,
)

# Package RPM binaries and the updated rpmdb into an OCI layer tarball using public rpm_layer rule.
rpm_layer(
    name = "ol9_curl_layer_tar",
    gpgcheck = True,
    rpmdb = ":ol9_curl_rpmdb",
    rpms = OL9_CURL_RPMS,
)

# Cross-architecture: aarch64 RPMs verified and merged on whatever host runs the build.
rpm_mark(
    name = "ol9_curl_aarch64_rpmdb",
    base_rpmdb = ":ol9_rpmdb",
    rpms = OL9_CURL_AARCH64_RPMS,
)

rpm_layer(
    name = "ol9_curl_aarch64_layer_tar",
    gpgcheck = True,
    rpmdb = ":ol9_curl_aarch64_rpmdb",
    rpms = OL9_CURL_AARCH64_RPMS,
)

# Negative case: no rpmdb and no keys, so verification must reject the signed RPMs (NOKEY).
# Built by CI, which expects the build to fail; manual so that //... stays green.
rpm_layer(
    name = "ol9_curl_nokey_layer_tar",
    gpgcheck = True,
    rpms = ["@ol9_curl_rpm//file"],
    tags = ["manual"],
)

# Build OCI layer and image manifest with the new layer.
layer_from_tar(
    name = "ol9_curl_layer",
    src = ":ol9_curl_layer_tar",
)

image_manifest(
    name = "ol9_curl_image",
    base = "@oraclelinux_9_slim//:image",
    layers = [":ol9_curl_layer"],
)

# Target to load the image into the local Docker daemon.
image_load(
    name = "load_ol9_curl_image",
    image = ":ol9_curl_image",
    tag = "localhost/e2e-curl-test:latest",
)

# Test container execution without network access.
sh_test(
    name = "validate_image_offline",
    srcs = ["validate_image.sh"],
    args = ["localhost/e2e-curl-test:latest"],
    tags = [
        "local",
        "manual",
    ],
)
