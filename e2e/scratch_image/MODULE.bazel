"""E2E tests for assembling and running curl from Oracle Linux 10 on a scratch container image."""

module(name = "scratch_image")

bazel_dep(name = "dnf5-prebuilt", version = "0.0.0")
local_path_override(
    module_name = "dnf5-prebuilt",
    path = "../..",
)

bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_img", version = "0.3.24-20261029-189a6a2")
bazel_dep(name = "tar.bzl", version = "0.10.9")

dnf5 = use_extension("@dnf5-prebuilt//dnf5-prebuilt:extensions.bzl", "dnf5")
dnf5.toolchains()
dnf5.lock(
    name = "ol10_scratch_curl_amd64",
    lockfile = "//:ol10_scratch_curl_amd64_lock.lock.json",
)
dnf5.lock(
    name = "ol10_scratch_curl_arm64",
    lockfile = "//:ol10_scratch_curl_arm64_lock.lock.json",
)
use_repo(
    dnf5,
    "dnf5_toolchains",
    "ol10_scratch_curl_amd64",
    "ol10_scratch_curl_arm64",
)

register_toolchains("@dnf5_toolchains//:all")

bsd_tar_toolchains = use_extension("@tar.bzl//tar:extensions.bzl", "toolchains")
use_repo(bsd_tar_toolchains, "bsd_tar_toolchains")

register_toolchains("@bsd_tar_toolchains//:all")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "ol10_gpg_key",
    downloaded_file_path = "RPM-GPG-KEY-oracle-ol10.key",
    sha256 = "9badfdf6c90098658e3154fed1b8d4d0eefd19c193982b27c68f6a73a1b21695",
    urls = ["https://yum.oracle.com/RPM-GPG-KEY-oracle-ol10"],
)
