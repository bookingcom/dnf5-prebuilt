"""E2E tests for assembling and running curl from Oracle Linux 10 on a scratch container image."""

module(name = "scratch_image")

bazel_dep(name = "dnf5-prebuilt", version = "0.0.0")
local_path_override(
    module_name = "dnf5-prebuilt",
    path = "../..",
)

bazel_dep(name = "bazel_lib", version = "3.8.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_shell", version = "0.10.0")
bazel_dep(name = "aspect_rules_py", version = "2.0.0-alpha.10")
bazel_dep(name = "rules_img", version = "0.3.24-20261101-d0a468b")
bazel_dep(name = "tar.bzl", version = "0.10.9")
bazel_dep(name = "package_metadata", version = "0.0.15")
bazel_dep(name = "supply_chain_tools", version = "0.0.3")
archive_override(
    module_name = "supply_chain_tools",
    integrity = "sha256-YpP3ZodjRBBKIAgyOXhRMyGDIs4oqsC0MEC8VHn1pRM=",
    strip_prefix = "supply_chain_tools-0.0.3/tools",
    urls = ["https://github.com/bazel-contrib/supply-chain/releases/download/supply_chain_tools-0.0.3/supply_chain_tools-0.0.3.tar.gz"],
)

archive_override(
    module_name = "supply-chain-go",
    integrity = "sha256-iUcy/deO90HaWGFS4Zas+KctlULjXawYEPlqnWQK5s0=",
    strip_prefix = "supply-chain-go-0.0.11/lib/supplychain-go",
    urls = ["https://github.com/bazel-contrib/supply-chain/releases/download/supply-chain-go-0.0.11/supply-chain-go-0.0.11.tar.gz"],
)

dnf5 = use_extension("@dnf5-prebuilt//dnf5-prebuilt:extensions.bzl", "dnf5")
dnf5.lock(
    name = "ol10_scratch_curl_amd64",
    lockfile = "//:ol10_scratch_curl_amd64_lock.lock.json",
)
dnf5.lock(
    name = "ol10_scratch_curl_arm64",
    lockfile = "//:ol10_scratch_curl_arm64_lock.lock.json",
)
use_repo(
    dnf5,
    "ol10_scratch_curl_amd64",
    "ol10_scratch_curl_arm64",
)

bsd_tar_toolchains = use_extension("@tar.bzl//tar:extensions.bzl", "toolchains")
use_repo(bsd_tar_toolchains, "bsd_tar_toolchains")

register_toolchains("@bsd_tar_toolchains//:all")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "ol10_gpg_key",
    downloaded_file_path = "RPM-GPG-KEY-oracle-ol10.key",
    sha256 = "9badfdf6c90098658e3154fed1b8d4d0eefd19c193982b27c68f6a73a1b21695",
    urls = ["https://yum.oracle.com/RPM-GPG-KEY-oracle-ol10"],
)
