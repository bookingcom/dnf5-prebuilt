load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("@dnf5-prebuilt//dnf5-prebuilt:defs.bzl", "dnf_config", "rpm_layer", "rpm_lock", "rpm_mark")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files([
    "ol10_scratch_curl_amd64_lock.lock.json",
    "ol10_scratch_curl_arm64_lock.lock.json",
])

# DNF configuration for OL10
dnf_config(
    name = "ol10_amd64_dnf_config",
    arch = [
        "x86_64",
        "noarch",
    ],
    install_langs = "en_US.UTF-8",
    install_weak_deps = False,
    releasever = "10",
    repo_configs = [":oracle-linux-ol10.repo"],
    vars = {
        "ocidomain": "oracle.com",
        "ociregion": "",
    },
)

dnf_config(
    name = "ol10_arm64_dnf_config",
    arch = [
        "aarch64",
        "noarch",
    ],
    install_langs = "en_US.UTF-8",
    install_weak_deps = False,
    releasever = "10",
    repo_configs = [":oracle-linux-ol10.repo"],
    vars = {
        "ocidomain": "oracle.com",
        "ociregion": "",
    },
)

# rpm_lock resolving curl and bash from scratch
rpm_lock(
    name = "ol10_scratch_curl_amd64_lock",
    arch = [
        "x86_64",
        "noarch",
    ],
    config = ":ol10_amd64_dnf_config",
    install_weak_deps = False,
    packages = [
        "bash",
        "curl",
    ],
)

rpm_lock(
    name = "ol10_scratch_curl_arm64_lock",
    arch = [
        "aarch64",
        "noarch",
    ],
    config = ":ol10_arm64_dnf_config",
    install_weak_deps = False,
    packages = [
        "bash",
        "curl",
    ],
)

# Test that generated lock files contain valid package entries, URLs, and sha256 checksums.
sh_test(
    name = "test_generated_locks",
    srcs = ["run_lock_test.sh"],
    args = [
        "$(rootpath :ol10_scratch_curl_amd64_lock)",
        "$(rootpath :ol10_scratch_curl_arm64_lock)",
    ],
    data = [
        "test_lock_generated.py",
        ":ol10_scratch_curl_amd64_lock",
        ":ol10_scratch_curl_arm64_lock",
    ],
)

# Oracle Linux 10: amd64 and arm64 curl rpmdb and layer targets on scratch
# Topologically ordered RPM labels are exposed by the Bzlmod extension repositories.
rpm_mark(
    name = "ol10_scratch_curl_amd64_rpmdb",
    rpms = ["@ol10_scratch_curl_amd64//:rpms"],
)

rpm_layer(
    name = "ol10_scratch_curl_amd64_layer_tar",
    gpgcheck = True,
    gpgkeys = ["@ol10_gpg_key//file"],
    install_langs = "en_US.UTF-8",
    rpmdb = ":ol10_scratch_curl_amd64_rpmdb",
    rpms = ["@ol10_scratch_curl_amd64//:rpms"],
)

rpm_mark(
    name = "ol10_scratch_curl_arm64_rpmdb",
    rpms = ["@ol10_scratch_curl_arm64//:rpms"],
)

rpm_layer(
    name = "ol10_scratch_curl_arm64_layer_tar",
    gpgcheck = True,
    gpgkeys = ["@ol10_gpg_key//file"],
    install_langs = "en_US.UTF-8",
    rpmdb = ":ol10_scratch_curl_arm64_rpmdb",
    rpms = ["@ol10_scratch_curl_arm64//:rpms"],
)

# Wrap validation script in hermetic py_binary
py_binary(
    name = "test_layer_symlinks_bin",
    srcs = ["test_layer_symlinks.py"],
    main = "test_layer_symlinks.py",
)

# Test that rpm_layer archives contain no entries with symlinked parents (issue #48)
sh_test(
    name = "test_layer_no_symlinked_parents",
    srcs = ["run_layer_symlinks_test.sh"],
    args = [
        "$(rootpath :test_layer_symlinks_bin)",
        "$(rootpath :ol10_scratch_curl_amd64_layer_tar)",
        "$(rootpath :ol10_scratch_curl_arm64_layer_tar)",
    ],
    data = [
        ":ol10_scratch_curl_amd64_layer_tar",
        ":ol10_scratch_curl_arm64_layer_tar",
        ":test_layer_symlinks_bin",
    ],
)

# Build OCI layer and image manifest on top of scratch base
layer_from_tar(
    name = "ol10_scratch_curl_amd64_layer",
    src = ":ol10_scratch_curl_amd64_layer_tar",
)

layer_from_tar(
    name = "ol10_scratch_curl_arm64_layer",
    src = ":ol10_scratch_curl_arm64_layer_tar",
)

image_manifest(
    name = "ol10_scratch_curl_amd64_image",
    env = {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    },
    layers = [":ol10_scratch_curl_amd64_layer"],
    platform = "@rules_img//img/private/platforms:linux_amd64",
)

image_manifest(
    name = "ol10_scratch_curl_arm64_image",
    env = {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    },
    layers = [":ol10_scratch_curl_arm64_layer"],
    platform = "@rules_img//img/private/platforms:linux_arm64",
)

# Target to load the image into the local Docker daemon
image_load(
    name = "load_ol10_scratch_curl_amd64_image",
    image = ":ol10_scratch_curl_amd64_image",
    tag_list = [
        "localhost/e2e-ol10-scratch-curl:latest",
        "localhost/e2e-ol10-scratch-curl-amd64:latest",
    ],
)

image_load(
    name = "load_ol10_scratch_curl_arm64_image",
    image = ":ol10_scratch_curl_arm64_image",
    tag_list = [
        "localhost/e2e-ol10-scratch-curl:latest",
        "localhost/e2e-ol10-scratch-curl-arm64:latest",
    ],
)

# Test container execution without network access
sh_test(
    name = "validate_scratch_image_offline",
    srcs = ["validate_image.sh"],
    args = ["localhost/e2e-ol10-scratch-curl:latest"],
    tags = [
        "local",
        "manual",
        "requires-network",
    ],
)

EXTRACTED_SCRIPTS = [
    "@ol10_scratch_curl_amd64//bazel/bash:post-script",
    "@ol10_scratch_curl_amd64//bazel/ca-certificates:post-script",
    "@ol10_scratch_curl_amd64//bazel/ca-certificates:pre-script",
    "@ol10_scratch_curl_amd64//bazel/crypto-policies:post-script",
    "@ol10_scratch_curl_amd64//bazel/crypto-policies:pre-script",
    "@ol10_scratch_curl_amd64//bazel/glibc:post-script",
    "@ol10_scratch_curl_amd64//bazel/glibc:pre-script",
    "@ol10_scratch_curl_amd64//bazel/libgcc:post-script",
    "@ol10_scratch_curl_amd64//bazel/p11-kit-trust:post-script",
    "@ol10_scratch_curl_amd64//bazel/pcre2:post-script",
    "@ol10_scratch_curl_amd64//bazel/setup:post-script",
]

filegroup(
    name = "extracted_scripts",
    srcs = EXTRACTED_SCRIPTS,
    visibility = ["//visibility:public"],
)

py_binary(
    name = "test_extracted_scripts_bin",
    srcs = ["test_extracted_scripts.py"],
    main = "test_extracted_scripts.py",
)

sh_test(
    name = "extracted_scripts_test",
    srcs = ["run_extracted_scripts_test.sh"],
    args = [
        "$(rootpath :test_extracted_scripts_bin)",
        "--script",
        "setup:post-script",
        "$(rootpath @ol10_scratch_curl_amd64//bazel/setup:post-script)",
        "--script",
        "bash:post-script",
        "$(rootpath @ol10_scratch_curl_amd64//bazel/bash:post-script)",
        "--script",
        "glibc:pre-script",
        "$(rootpath @ol10_scratch_curl_amd64//bazel/glibc:pre-script)",
        "--script",
        "glibc:post-script",
        "$(rootpath @ol10_scratch_curl_amd64//bazel/glibc:post-script)",
        "--script",
        "crypto-policies:pre-script",
        "$(rootpath @ol10_scratch_curl_amd64//bazel/crypto-policies:pre-script)",
        "--script",
        "crypto-policies:post-script",
        "$(rootpath @ol10_scratch_curl_amd64//bazel/crypto-policies:post-script)",
        "--script",
        "ca-certificates:pre-script",
        "$(rootpath @ol10_scratch_curl_amd64//bazel/ca-certificates:pre-script)",
        "--script",
        "ca-certificates:post-script",
        "$(rootpath @ol10_scratch_curl_amd64//bazel/ca-certificates:post-script)",
        "--script",
        "libgcc:post-script",
        "$(rootpath @ol10_scratch_curl_amd64//bazel/libgcc:post-script)",
        "--script",
        "p11-kit-trust:post-script",
        "$(rootpath @ol10_scratch_curl_amd64//bazel/p11-kit-trust:post-script)",
        "--script",
        "pcre2:post-script",
        "$(rootpath @ol10_scratch_curl_amd64//bazel/pcre2:post-script)",
    ],
    data = [":test_extracted_scripts_bin"] + EXTRACTED_SCRIPTS,
)
