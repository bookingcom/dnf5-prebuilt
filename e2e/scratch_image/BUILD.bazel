    "@ol10_libcap_aarch64_rpm//file",
    "@ol10_libcbor_aarch64_rpm//file",
    "@ol10_libcom_err_aarch64_rpm//file",
    "@ol10_libcurl_aarch64_rpm//file",
    "@ol10_libeconf_aarch64_rpm//file",
