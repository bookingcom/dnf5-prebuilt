load("@bazel_binaries//:defs.bzl", "bazel_binaries")
load(
    "@rules_bazel_integration_test//bazel_integration_test:defs.bzl",
    "bazel_integration_test",
    "default_test_runner",
    "integration_test_utils",
)

default_test_runner(
    name = "default_test_runner",
)

bazel_integration_test(
    name = "smoke_e2e_test",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = [
        "//bazel/release:dist_dir",
    ],
    env = {
        "DNF5_PREBUILT_DIST_DIR": "$(rootpath //bazel/release:dist_dir)",
    },
    tags = integration_test_utils.DEFAULT_INTEGRATION_TEST_TAGS + [
        "no-sandbox",
    ],
    test_runner = ":default_test_runner",
    workspace_files = integration_test_utils.glob_workspace_files("smoke_test") + [
        "//:local_repository_files",
    ],
    workspace_path = "smoke_test",
)

bazel_integration_test(
    name = "scratch_image_e2e_test",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = [
        "//bazel/release:dist_dir",
    ],
    env = {
        "DNF5_PREBUILT_DIST_DIR": "$(rootpath //bazel/release:dist_dir)",
    },
    tags = integration_test_utils.DEFAULT_INTEGRATION_TEST_TAGS + [
        "no-sandbox",
    ],
    test_runner = ":default_test_runner",
    workspace_files = integration_test_utils.glob_workspace_files("scratch_image") + [
        "//:local_repository_files",
    ],
    workspace_path = "scratch_image",
)

test_suite(
    name = "e2e",
    tags = integration_test_utils.DEFAULT_INTEGRATION_TEST_TAGS,
    tests = [
        ":scratch_image_e2e_test",
        ":smoke_e2e_test",
    ],
    visibility = ["//visibility:public"],
)
