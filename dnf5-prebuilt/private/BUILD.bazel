load("@aspect_rules_py//py:defs.bzl", "py_binary")

package(default_visibility = ["//dnf5-prebuilt:__subpackages__"])

exports_files(
    glob(["*.bzl"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "all_files",
    srcs = glob(["*"]),
    visibility = ["//visibility:public"],
)

py_binary(
    name = "rpm_merge",
    srcs = ["rpm_merge.py"],
)

py_binary(
    name = "tar_dedup",
    srcs = ["tar_dedup.py"],
)

py_binary(
    name = "tar_inject_rpmdb",
    srcs = ["tar_inject_rpmdb.py"],
)

py_binary(
    name = "rpm_gpg_keystore",
    srcs = ["rpm_gpg_keystore.py"],
)

py_binary(
    name = "rpm_gpg_verify",
    srcs = ["rpm_gpg_verify.py"],
)

py_binary(
    name = "rpm_mark",
    srcs = ["rpm_mark.py"],
)

py_binary(
    name = "rpm_extract",
    srcs = ["rpm_extract.py"],
)

py_binary(
    name = "rpm_script",
    srcs = ["rpm_script.py"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "render_repos_d",
    srcs = ["render_repos_d.py"],
)
