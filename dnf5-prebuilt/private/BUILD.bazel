load("@aspect_rules_py//py:defs.bzl", "py_binary")

package(default_visibility = ["//dnf5-prebuilt:__subpackages__"])

exports_files(
    glob([
        "*.bzl",
        "*.patch",
        "*.tpl",
    ]),
    visibility = ["//visibility:public"],
)

py_binary(
    name = "tar_dedup",
    srcs = ["tar_dedup.py"],
)

py_binary(
    name = "tar_inject_rpmdb",
    srcs = ["tar_inject_rpmdb.py"],
)

py_binary(
    name = "rpm_gpg_keystore",
    srcs = ["rpm_gpg_keystore.py"],
)

py_binary(
    name = "rpm_gpg_verify",
    srcs = ["rpm_gpg_verify.py"],
)

py_binary(
    name = "rpm_merge",
    srcs = ["rpm_merge.py"],
)

py_binary(
    name = "rpm_mark",
    srcs = ["rpm_mark.py"],
)

py_binary(
    name = "rpm_lock",
    srcs = ["rpm_lock.py"],
    dep_group = "dnf5-prebuilt",
    deps = [
        "@uv//repomd:pkg",
        "@uv//zstandard:pkg",
    ],
)
