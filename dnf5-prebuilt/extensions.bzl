"""Module extension fetching prebuilt dnf5 distributions and RPM packages from lockfiles.

```starlark
bazel_dep(name = "dnf5-prebuilt", version = "...")

dnf5 = use_extension("@dnf5-prebuilt//dnf5-prebuilt:extensions.bzl", "dnf5")
dnf5.toolchains()
use_repo(dnf5, "dnf5_toolchains")

register_toolchains("@dnf5_toolchains//:all")
```

For testing unreleased builds, setting the `DNF5_PREBUILT_DIST_DIR`
environment variable (e.g. `--repo_env=DNF5_PREBUILT_DIST_DIR=/path`) makes the
extension use `dnf5-<version>-<platform>.tar.gz` archives from that directory
instead of the published ones, without integrity checks.
"""

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
load("//dnf5-prebuilt/private:platforms.bzl", "PLATFORMS")
load(
    "//dnf5-prebuilt/private:repositories.bzl",
    "dnf5_dist_repository",
    "dnf5_lock_hub_repository",
    "dnf5_toolchains_repository",
)
load("//dnf5-prebuilt/private:versions.bzl", "DEFAULT_VERSION", "RELEASE_URL_TEMPLATE", "VERSIONS")

_toolchains = tag_class(
    doc = "Declares a set of dnf5 toolchains, one per supported platform.",
    attrs = {
        "name": attr.string(
            default = "dnf5",
            doc = "Base name of the generated repositories: `<name>_toolchains` and `<name>_<platform>`.",
        ),
        "version": attr.string(
            default = DEFAULT_VERSION,
            values = VERSIONS.keys(),
            doc = "dnf5 version.",
        ),
    },
)

_lock = tag_class(
    doc = "Loads an RPM lockfile and creates a repository exposing its packages in topological install_order.",
    attrs = {
        "lockfile": attr.label(
            mandatory = True,
            allow_single_file = [".json"],
            doc = "Label of the JSON lockfile generated by `rpm_lock`.",
        ),
        "name": attr.string(
            mandatory = True,
            doc = "Name of the hub repository to create.",
        ),
    },
)

def _sanitize_repo_name(s):
    out = []
    for i in range(len(s)):
        c = s[i]
        if c.isalnum() or c in ("_", "-", "."):
            out.append(c)
        else:
            out.append("_")
    return "".join(out)

def _process_lock_tag(mctx, tag):
    content = mctx.read(tag.lockfile)
    data = json.decode(content)
    packages = data.get("packages", [])
    install_order = data.get("install_order", [])

    pkg_by_name = {}
    for pkg in packages:
        name = pkg.get("name")
        if name:
            pkg_by_name[name] = pkg

    if install_order:
        ordered_pkgs = []
        seen_names = {}
        for name in install_order:
            if name in pkg_by_name and name not in seen_names:
                ordered_pkgs.append(pkg_by_name[name])
                seen_names[name] = True
        for pkg in packages:
            name = pkg.get("name")
            if name and name not in seen_names:
                ordered_pkgs.append(pkg)
                seen_names[name] = True
    else:
        ordered_pkgs = packages

    rpm_labels = []
    alias_rules = []
    for pkg in ordered_pkgs:
        pkg_name = pkg["name"]
        nevra = "%s-%s.%s" % (pkg_name, pkg.get("version", "0"), pkg.get("arch", "noarch"))
        url = pkg["url"]
        integrity = pkg["integrity"]

        url_base = url.rsplit("/", 1)[-1] if "/" in url else ""
        if url_base.endswith(".rpm") and ":" not in url_base:
            downloaded_file_path = url_base
        else:
            downloaded_file_path = (nevra + ".rpm").replace(":", "_")

        repo_name = "%s__%s" % (tag.name, _sanitize_repo_name(pkg_name))
        http_file(
            name = repo_name,
            downloaded_file_path = downloaded_file_path,
            integrity = integrity,
            urls = [url],
        )

        label_str = "@%s//file" % repo_name
        rpm_labels.append(label_str)
        alias_rules.append("""\
alias(
    name = {name},
    actual = {actual},
)
""".format(
            name = repr(pkg_name),
            actual = repr(label_str),
        ))

    build_content = """\
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "rpms",
    srcs = {rpms},
)

{aliases}""".format(
        rpms = repr(rpm_labels),
        aliases = "\n".join(alias_rules),
    )

    defs_content = "RPMS = %s\n" % repr(rpm_labels)

    package_build_files = {}
    for pkg in ordered_pkgs:
        pkg_name = pkg["name"]
        has_pre = pkg.get("pre_install_script", False)
        has_post = pkg.get("post_install_script", False)
        if has_pre or has_post:
            repo_name = "%s__%s" % (tag.name, _sanitize_repo_name(pkg_name))
            rpm_label = "@%s//file" % repo_name
            rules = [
                'load("@dnf5-prebuilt//dnf5-prebuilt:defs.bzl", "rpm_script")',
                "",
                'package(default_visibility = ["//visibility:public"])',
                "",
            ]
            if has_pre:
                rules.append("""\
rpm_script(
    name = "pre-script",
    rpm = {rpm},
)
""".format(rpm = repr(rpm_label)))
            if has_post:
                rules.append("""\
rpm_script(
    name = "post-script",
    rpm = {rpm},
)
""".format(rpm = repr(rpm_label)))
            package_build_files["bazel/%s/BUILD.bazel" % pkg_name] = "\n".join(rules)

    dnf5_lock_hub_repository(
        name = tag.name,
        build_content = build_content,
        defs_content = defs_content,
        package_build_files = package_build_files,
    )

def _dnf5_extension_impl(mctx):
    local_dir = mctx.getenv("DNF5_PREBUILT_DIST_DIR")
    seen = {}
    seen_locks = {}
    for mod in mctx.modules:
        for tag in mod.tags.toolchains:
            if tag.name in seen:
                if seen[tag.name] != tag.version and mod.is_root:
                    fail("dnf5.toolchains(name = %r) is declared with versions %s and %s" %
                         (tag.name, seen[tag.name], tag.version))
                continue
            seen[tag.name] = tag.version
            release = VERSIONS[tag.version]
            dist_repos = {}
            for platform in PLATFORMS:
                repo = "%s_%s" % (tag.name, platform)
                if local_dir:
                    urls = ["file://%s/dnf5-%s-%s.tar.gz" % (local_dir, tag.version, platform)]
                    integrity = ""
                else:
                    urls = [RELEASE_URL_TEMPLATE.format(
                        tag = release["tag"],
                        version = tag.version,
                        platform = platform,
                    )]
                    integrity = release["integrity"].get(platform, "")
                dnf5_dist_repository(
                    name = repo,
                    urls = urls,
                    integrity = integrity,
                    version = tag.version,
                )
                dist_repos[platform] = repo
            dnf5_toolchains_repository(
                name = tag.name + "_toolchains",
                dist_repos = dist_repos,
                platforms = PLATFORMS.keys(),
            )
        for lock_tag in mod.tags.lock:
            if lock_tag.name in seen_locks:
                if seen_locks[lock_tag.name] != lock_tag.lockfile and mod.is_root:
                    fail("dnf5.lock(name = %r) is declared with conflicting lockfiles %s and %s" %
                         (lock_tag.name, seen_locks[lock_tag.name], lock_tag.lockfile))
                continue
            seen_locks[lock_tag.name] = lock_tag.lockfile
            _process_lock_tag(mctx, lock_tag)
    return mctx.extension_metadata(reproducible = not local_dir)

dnf5 = module_extension(
    implementation = _dnf5_extension_impl,
    doc = "Fetches prebuilt dnf5 distributions, declares their toolchains, and loads RPM lockfiles.",
    tag_classes = {
        "lock": _lock,
        "toolchains": _toolchains,
    },
    environ = ["DNF5_PREBUILT_DIST_DIR"],
)
