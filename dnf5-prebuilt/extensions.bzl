"""Module extension fetching prebuilt dnf5 distributions and RPM packages from lockfiles.

```starlark
bazel_dep(name = "dnf5-prebuilt", version = "...")

dnf5 = use_extension("@dnf5-prebuilt//dnf5-prebuilt:extensions.bzl", "dnf5")
dnf5.toolchains()
use_repo(dnf5, "dnf5_toolchains")

register_toolchains("@dnf5_toolchains//:all")
```

For testing unreleased builds, setting the `DNF5_PREBUILT_DIST_DIR`
environment variable (e.g. `--repo_env=DNF5_PREBUILT_DIST_DIR=/path`) makes the
extension use `dnf5-<version>-<platform>.tar.gz` archives from that directory
instead of the published ones, without integrity checks.
"""

load("@package_metadata//purl:purl.bzl", "purl")
load("//dnf5-prebuilt/private:platforms.bzl", "PLATFORMS")
load(
    "//dnf5-prebuilt/private:repositories.bzl",
    "dnf5_dist_repository",
    "dnf5_lock_hub_repository",
    "dnf5_rpm_repository",
    "dnf5_toolchains_repository",
)
load("//dnf5-prebuilt/private:versions.bzl", "DEFAULT_VERSION", "RELEASE_URL_TEMPLATE", "VERSIONS")

_toolchains = tag_class(
    doc = "Declares a set of dnf5 toolchains, one per supported platform.",
    attrs = {
        "name": attr.string(
            default = "dnf5",
            doc = "Base name of the generated repositories: `<name>_toolchains` and `<name>_<platform>`.",
        ),
        "version": attr.string(
            default = DEFAULT_VERSION,
            values = VERSIONS.keys(),
            doc = "dnf5 version.",
        ),
    },
)

_lock = tag_class(
    doc = "Loads an RPM lockfile and creates a repository exposing its packages in topological install_order.",
    attrs = {
        "lockfile": attr.label(
            mandatory = True,
            allow_single_file = [".json"],
            doc = "Label of the JSON lockfile generated by `rpm_lock`.",
        ),
        "name": attr.string(
            mandatory = True,
            doc = "Name of the hub repository to create.",
        ),
    },
)

def _sanitize_repo_name(s):
    out = []
    for i in range(len(s)):
        c = s[i]
        if c.isalnum() or c in ("_", "-", "."):
            out.append(c)
        else:
            out.append("_")
    return "".join(out)

def _extract_digits_after(s, prefix):
    idx = s.find(prefix)
    if idx == -1:
        return ""
    digits = []
    for i in range(idx + len(prefix), len(s)):
        c = s[i]
        if c.isdigit():
            digits.append(c)
        else:
            break
    return "".join(digits)

def _extract_vendor_and_distro(pkg, url, filename):
    """Infers vendor namespace and distro qualifier from package metadata, URL and filename."""
    vendor = pkg.get("vendor")
    distro = pkg.get("distro")

    url_lower = url.lower()
    fn_lower = filename.lower()
    ver_lower = pkg.get("version", "").lower()
    haystack = fn_lower + " " + ver_lower

    if not vendor:
        if "oracle" in url_lower or "oracle" in fn_lower or "/ol" in url_lower:
            vendor = "oracle"
        elif "fedora" in url_lower or "fedora" in fn_lower:
            vendor = "fedora"
        elif "centos" in url_lower or "centos" in fn_lower:
            vendor = "centos"
        elif "rocky" in url_lower or "rocky" in fn_lower:
            vendor = "rocky"
        elif "almalinux" in url_lower or "almalinux" in fn_lower or "alma" in url_lower:
            vendor = "almalinux"
        elif "redhat" in url_lower or "rhel" in url_lower:
            vendor = "redhat"
        elif "amazon" in url_lower or "amazonlinux" in url_lower or "amzn" in url_lower or ".amzn" in fn_lower:
            vendor = "amazonlinux"
        elif "opensuse" in url_lower:
            vendor = "opensuse"
        elif "suse" in url_lower or "sles" in url_lower:
            vendor = "suse"

    if not distro:
        el_num = _extract_digits_after(haystack, ".el")
        fc_num = _extract_digits_after(haystack, ".fc")
        amzn_num = _extract_digits_after(haystack, ".amzn")

        if el_num:
            if vendor == "oracle":
                distro = "ol" + el_num
            elif vendor == "centos":
                distro = "centos-" + el_num
            elif vendor == "rocky":
                distro = "rocky-" + el_num
            elif vendor == "almalinux":
                distro = "almalinux-" + el_num
            elif vendor == "redhat":
                distro = "rhel-" + el_num
            else:
                distro = "el" + el_num
        elif fc_num:
            distro = "fedora-" + fc_num
            if not vendor:
                vendor = "fedora"
        elif amzn_num:
            distro = "amzn" + amzn_num
            if not vendor:
                vendor = "amazonlinux"
        else:
            for ol_tag in ["ol10", "ol9", "ol8", "ol7"]:
                if ("/" + ol_tag + "/") in url_lower:
                    distro = ol_tag
                    if not vendor:
                        vendor = "oracle"
                    break

    if not vendor:
        if distro and distro.startswith("fedora-"):
            vendor = "fedora"
        elif distro and distro.startswith("amzn"):
            vendor = "amazonlinux"

    return vendor, distro

def _compute_rpm_purl(pkg, vendor = None, distro = None):
    builder = purl.builder().type("rpm").name(pkg["name"])

    v = pkg.get("vendor") or vendor
    if v:
        builder.namespace(v.lower())

    version = pkg.get("version", "")
    if ":" in version:
        epoch, ver_rel = version.split(":", 1)
        builder.version(ver_rel)
        if epoch:
            builder.add_qualifier("epoch", epoch)
    elif version:
        builder.version(version)

    arch = pkg.get("arch", "")
    if arch:
        builder.add_qualifier("arch", arch)

    d = pkg.get("distro") or distro
    if d:
        builder.add_qualifier("distro", d.lower())

    return builder.build()

def _process_lock_tag(mctx, tag):
    content = mctx.read(tag.lockfile)
    data = json.decode(content)
    packages = data.get("packages", [])
    install_order = data.get("install_order", [])

    pkg_by_name = {}
    for pkg in packages:
        name = pkg.get("name")
        if name:
            pkg_by_name[name] = pkg

    if install_order:
        ordered_pkgs = []
        seen_names = {}
        for name in install_order:
            if name in pkg_by_name and name not in seen_names:
                ordered_pkgs.append(pkg_by_name[name])
                seen_names[name] = True
        for pkg in packages:
            name = pkg.get("name")
            if name and name not in seen_names:
                ordered_pkgs.append(pkg)
                seen_names[name] = True
    else:
        ordered_pkgs = packages

    rpm_labels = []
    alias_rules = []
    for pkg in ordered_pkgs:
        pkg_name = pkg["name"]
        nevra = "%s-%s.%s" % (pkg_name, pkg.get("version", "0"), pkg.get("arch", "noarch"))
        url = pkg["url"]
        integrity = pkg["integrity"]

        url_base = url.rsplit("/", 1)[-1] if "/" in url else ""
        if url_base.endswith(".rpm") and ":" not in url_base:
            downloaded_file_path = url_base
        else:
            downloaded_file_path = (nevra + ".rpm").replace(":", "_")

        pkg_vendor, pkg_distro = _extract_vendor_and_distro(pkg, url, downloaded_file_path)
        repo_name = "%s__%s" % (tag.name, _sanitize_repo_name(pkg_name))
        purl_str = _compute_rpm_purl(pkg, vendor = pkg_vendor, distro = pkg_distro)
        dnf5_rpm_repository(
            name = repo_name,
            downloaded_file_path = downloaded_file_path,
            integrity = integrity,
            purl = purl_str,
            urls = [url],
        )

        label_str = "@%s//file" % repo_name
        rpm_labels.append(label_str)
        alias_rules.append("""\
alias(
    name = {name},
    actual = {actual},
)
""".format(
            name = repr(pkg_name),
            actual = repr(label_str),
        ))

    build_content = """\
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "rpms",
    srcs = {rpms},
)

{aliases}""".format(
        rpms = repr(rpm_labels),
        aliases = "\n".join(alias_rules),
    )

    defs_content = "RPMS = %s\n" % repr(rpm_labels)

    package_build_files = {}
    for pkg in ordered_pkgs:
        pkg_name = pkg["name"]
        repo_name = "%s__%s" % (tag.name, _sanitize_repo_name(pkg_name))
        rpm_label = "@%s//file" % repo_name
        has_pre = pkg.get("pre_install_script", False)
        has_post = pkg.get("post_install_script", False)

        rules = []
        if has_pre or has_post:
            rules.append('load("@dnf5-prebuilt//dnf5-prebuilt:defs.bzl", "rpm_script")')
            rules.append("")

        rules.append('package(default_package_metadata = ["@%s//:package_metadata"], default_visibility = ["//visibility:public"])' % repo_name)
        rules.append("")
        rules.append("""\
alias(
    name = "package_metadata",
    actual = "@%s//:package_metadata",
)

alias(
    name = "integrity",
    actual = "@%s//:integrity",
)
""" % (repo_name, repo_name))

        if has_pre:
            rules.append("""\
rpm_script(
    name = "pre-script",
    rpm = {rpm},
)
""".format(rpm = repr(rpm_label)))
        if has_post:
            rules.append("""\
rpm_script(
    name = "post-script",
    rpm = {rpm},
)
""".format(rpm = repr(rpm_label)))
        package_build_files["bazel/%s/BUILD.bazel" % pkg_name] = "\n".join(rules)

    dnf5_lock_hub_repository(
        name = tag.name,
        build_content = build_content,
        defs_content = defs_content,
        package_build_files = package_build_files,
    )

def _dnf5_extension_impl(mctx):
    local_dir = mctx.getenv("DNF5_PREBUILT_DIST_DIR")
    seen = {}
    seen_locks = {}
    for mod in mctx.modules:
        for tag in mod.tags.toolchains:
            if tag.name in seen:
                if seen[tag.name] != tag.version and mod.is_root:
                    fail("dnf5.toolchains(name = %r) is declared with versions %s and %s" %
                         (tag.name, seen[tag.name], tag.version))
                continue
            seen[tag.name] = tag.version
            release = VERSIONS[tag.version]
            dist_repos = {}
            for platform in PLATFORMS:
                repo = "%s_%s" % (tag.name, platform)
                if local_dir:
                    urls = ["file://%s/dnf5-%s-%s.tar.gz" % (local_dir, tag.version, platform)]
                    integrity = ""
                else:
                    urls = [RELEASE_URL_TEMPLATE.format(
                        tag = release["tag"],
                        version = tag.version,
                        platform = platform,
                    )]
                    integrity = release["integrity"].get(platform, "")
                dnf5_dist_repository(
                    name = repo,
                    urls = urls,
                    integrity = integrity,
                    version = tag.version,
                )
                dist_repos[platform] = repo
            dnf5_toolchains_repository(
                name = tag.name + "_toolchains",
                dist_repos = dist_repos,
                platforms = PLATFORMS.keys(),
            )
        for lock_tag in mod.tags.lock:
            if lock_tag.name in seen_locks:
                if seen_locks[lock_tag.name] != lock_tag.lockfile and mod.is_root:
                    fail("dnf5.lock(name = %r) is declared with conflicting lockfiles %s and %s" %
                         (lock_tag.name, seen_locks[lock_tag.name], lock_tag.lockfile))
                continue
            seen_locks[lock_tag.name] = lock_tag.lockfile
            _process_lock_tag(mctx, lock_tag)
    return mctx.extension_metadata(reproducible = not local_dir)

dnf5 = module_extension(
    implementation = _dnf5_extension_impl,
    doc = "Fetches prebuilt dnf5 distributions, declares their toolchains, and loads RPM lockfiles.",
    tag_classes = {
        "lock": _lock,
        "toolchains": _toolchains,
    },
    environ = ["DNF5_PREBUILT_DIST_DIR"],
)
