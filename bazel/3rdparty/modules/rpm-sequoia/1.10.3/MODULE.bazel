module(
    name = "rpm-sequoia",
    version = "1.10.3",
    bazel_compatibility = [">=8.5.0"],
    compatibility_level = 1,
)

bazel_dep(name = "openssl", version = "4.0.3.bcr.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_rs", version = "0.1.3")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "rpm_sequoia_crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "rpm_sequoia_crates")

# rules_rs' well-known annotation for openssl-sys: build it against the BCR
# openssl instead of probing the host. Cargo.lock lists openssl-sys because it
# covers every crypto backend; the crypto-rust backend used here does not
# compile it, but this keeps the lockfile hermetic and silences rules_rs'
# warning. inject_repo() only works in the root module, so the canonical name
# of the openssl repository is used instead (visible from every repository).
crate.annotation(
    build_script_data = [
        "@@openssl+//:gen_dir",
    ],
    build_script_env = {
        "OPENSSL_DIR": "$(execpath @@openssl+//:gen_dir)",
        "OPENSSL_NO_VENDOR": "1",
        "OPENSSL_STATIC": "1",
    },
    crate = "openssl-sys",
    gen_build_script = "on",
    repositories = ["rpm_sequoia_crates"],
)
